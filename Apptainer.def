Bootstrap: docker
From: python:3.11-slim

%labels
    Maintainer Fabiano Menegidio <labiomics@bioinformatica.com.br>
    Version 0.1.0
    Description Reproducible Apptainer/Singularity container for nextSSR

%files
    . /opt/nextSSR

%post
    apt-get update && apt-get install -y --no-install-recommends build-essential git
    cd /opt/nextSSR
    pip install --no-cache-dir .

%environment
    export LC_ALL=C

%runscript
    exec nextssr "$@"
